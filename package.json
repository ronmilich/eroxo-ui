{
  "name": "eroxo-ui",
  "version": "0.0.0",
  "description": "Eroxo UI core components for SolidJS",
  "license": "MIT",
  "contributors": [],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ronmilich/eroxo-ui.git"
  },
  "homepage": "https://github.com/ronmilich/eroxo-ui#readme",
  "bugs": {
    "url": "https://github.com/ronmilich/eroxo-ui/issues"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "private": false,
  "sideEffects": false,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "node": "./dist/server.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "dev": "vite serve dev",
    "build": "vite build && vite build --ssr src/index.tsx && tsc -p tsconfig.build.json",
    "test": "pnpm test:client && pnpm test:ssr",
    "test:client": "vitest run",
    "test:ssr": "vitest run --mode ssr",
    "prepublishOnly": "pnpm build",
    "format": "prettier --ignore-path .gitignore -w \"src/**/*.{js,ts,json,css,tsx,jsx}\" \"dev/**/*.{js,ts,json,css,tsx,jsx}\"",
    "lint": "pnpm lint:code && pnpm lint:types",
    "lint:code": "oxlint --type-aware --deny-warnings src test",
    "lint:types": "tsc --noEmit && tsc -p dev --noEmit",
    "update-deps": "pnpm up -Li"
  },
  "peerDependencies": {
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3"
  },
  "devDependencies": {
    "@solidjs/web": "^2.0.3",
    "solid-js": "^2.0.3",
    "@solidjs/vite-plugin": "^3.0.1",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2008",
    "prettier": "3.10.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "keywords": [
    "solid"
  ],
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26",
    "pnpm": ">=12.21.0"
  }
}
